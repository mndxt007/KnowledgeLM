@page "/"
@using KnowledgeLM.App.Services
@inject AppNotificationService NotificationService
@inject IToastService ToastService
@implements IDisposable


<FluentMultiSplitter Orientation="Orientation.Horizontal">
    <FluentMultiSplitterPane Collapsible="true" Size="25%" Min="20%" Max="30%">
        <FluentMultiSplitter Orientation="Orientation.Vertical" >
            <FluentMultiSplitterPane Collapsible="true" Min="50%" Max="70%" Style="overflow-y: auto;" >
                <Notes />
            </FluentMultiSplitterPane>
            <FluentMultiSplitterPane Min="30%" Max="50%" >
                <GithubCLI />
            </FluentMultiSplitterPane>
        </FluentMultiSplitter>
    </FluentMultiSplitterPane>
    <FluentMultiSplitterPane  Class="m-3">
        <MarkDownView />
    </FluentMultiSplitterPane>
</FluentMultiSplitter>


@code {
    protected override void OnInitialized()
    {
        NotificationService.OnNotification += HandleNotification;
    }

    private void HandleNotification(AppNotification notification)
    {
        InvokeAsync(() =>
        {
            var intent = notification.Type switch
            {
                AppNotificationType.Success => ToastIntent.Success,
                AppNotificationType.Error => ToastIntent.Error,
                AppNotificationType.Progress => ToastIntent.Progress,
                AppNotificationType.Info => ToastIntent.Info,
                _ => ToastIntent.Info
            };
            ToastService.ShowToast(intent, notification.Message);
        });
    }

    public void Dispose()
    {
        NotificationService.OnNotification -= HandleNotification;
    }
}
