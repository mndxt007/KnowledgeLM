

@inherits LayoutComponentBase
@using KnowledgeLM.App.Services
@inject AppNotificationService NotificationService
@inject IToastService ToastService
@implements IDisposable

<FluentToastProvider Position="ToastPosition.BottomRight" />
<FluentDialogProvider />
<FluentTooltipProvider />
<FluentMessageBarProvider />
<FluentMenuProvider />
<FluentDesignTheme OfficeColor="OfficeColor.Teams" Mode="DesignThemeModes.Light" />


<FluentLayout Style="height: 100vh;">
@* Omitted in favour Native Layout
    <FluentHeader>
            KnowledgeLM
            <FluentSpacer />
            Learn more. Write less. Remember everything.
        </FluentHeader>
        *@


    <FluentStack Orientation="Orientation.Horizontal" Width="100%" Style="height : 100%">
        <NavMenu/>
        <FluentBodyContent Style="height: 100%">
                @Body
            </FluentBodyContent>
    </FluentStack>
</FluentLayout>

@code {
    protected override void OnInitialized()
    {
        NotificationService.OnNotification += HandleNotification;
    }

    private void HandleNotification(AppNotification notification)
    {
        InvokeAsync(() =>
        {
            var intent = notification.Type switch
            {
                AppNotificationType.Success => ToastIntent.Success,
                AppNotificationType.Error => ToastIntent.Error,
                AppNotificationType.Progress => ToastIntent.Progress,
                AppNotificationType.Info => ToastIntent.Info,
                _ => ToastIntent.Info
            };
            ToastService.ShowToast(intent, notification.Message);
        });
    }

    public void Dispose()
    {
        NotificationService.OnNotification -= HandleNotification;
    }
}
