@using KnowledgeLM.App.Components.Widgets.HomeWidgets
@using KnowledgeLM.MonacoEditor.Markdown

<FluentCard Style="height: 100%; display: flex; flex-direction: column;">
   
    @if(ResourceResponse is not null)
    {
        <div style="display: flex; align-items: center; justify-content: space-between; padding-right: 8px;">
            <FluentBreadcrumb Class="p-2">
                <FluentBreadcrumbItem Href="#">
                    @Breadcrumb?.CourseName
                    <FluentIcon Value="@(new Icons.Regular.Size16.BookOpen())" Color="@Color.Neutral" Slot="start" />
                </FluentBreadcrumbItem>
                <FluentBreadcrumbItem Href="#">
                    @Breadcrumb?.SectionName
                    <FluentIcon Value="@(new Icons.Regular.Size16.Folder())" Color="@Color.Neutral" Slot="start" />
                </FluentBreadcrumbItem>
                <FluentBreadcrumbItem>
                    @Breadcrumb?.ResourceName
                    <FluentIcon Value="@(new Icons.Regular.Size16.Document())" Color="@Color.Neutral" Slot="start" />
                </FluentBreadcrumbItem>
            </FluentBreadcrumb>
            <FluentButton Appearance="Appearance.Stealth" Title="Close" OnClick="CloseResource">
                <FluentIcon Value="@(new Icons.Regular.Size16.Dismiss())" Color="@Color.Neutral" />
            </FluentButton>
        </div>
        <div class="metadata-bar">
            <span class="badge-pill-success">
                <FluentIcon Value="@(new Icons.Regular.Size16.Notebook())" Color="@Color.Fill" />
                @ResourceResponse?.Location
            </span>
            <span class="badge-pill-success">
                <FluentIcon Value="@(new Icons.Regular.Size16.Clock())" Color="@Color.Fill" />
                @ResourceResponse?.LastModified.ToLocalTime().ToString("g")
            </span>
        </div>
        <FluentCard Style="box-shadow: 0 4px 8px var(--accent-fill-rest); border-radius: 4px; flex: 1; min-height: 0;" Class="m-2">
            <MonacoMarkdownEditor Markdown="@MarkDownContent"
                                  MarkdownChanged="@OnChanged" />
        </FluentCard>
    }
    else
    {
        <div class="landing-container">
            <div class="landing-icon @(_hasSearchResults ? "landing-icon-hidden" : "")">
                <FluentIcon Value="@(new Icons.Regular.Size32.Notebook())" Color="@Color.Accent" Style="width:48px;height:48px;" />
            </div>
            <h2 class="landing-title">Welcome to LearnLoom</h2>
            <p class="landing-subtitle">Select a resource from the sidebar to edit or view</p>
            <div class="landing-hints">
                <span class="landing-hint">
                    <FluentIcon Value="@(new Icons.Regular.Size16.BookOpen())" Color="@Color.Neutral" />
                    Browse courses
                </span>
                <span class="landing-hint">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Folder())" Color="@Color.Neutral" />
                    Open a section
                </span>
                <span class="landing-hint">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Document())" Color="@Color.Neutral" />
                    Pick a resource
                </span>
            </div>
            <SearchWidget HasResultsChanged="OnSearchResultsChanged" OnResourceClicked="OnSearchResourceClicked" />
        </div>
    }

</FluentCard>
